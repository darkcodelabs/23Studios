# Server binding
HOST=127.0.0.1
PORT=8090

# Session
# Generate with: openssl rand -hex 32
SESSION_SECRET=
STUDIO_PASSWORD=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Claude Code CLI binary (alias `claude` on most installs)
CLAUDE_CODE_BIN=claude

# Paths
PROJECTS_DATA_DIR=./server/data
DEFAULT_PROJECT_ROOT=/home/hakcer/projects

# Environment
NODE_ENV=production
