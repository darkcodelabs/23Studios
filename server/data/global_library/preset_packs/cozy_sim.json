        "uses_setOffset_for_shake": false,
        "uses_setMosaic_for_transitions": false,
        "uses_vcrPauseFilterImage": false,
        "preview_lua_template": "-- inOutBack on sprite scale on pickup"
      }
    },
    "transition_style": {
