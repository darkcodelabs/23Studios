        "face_dither": "bayer_4x4",
        "sprite_dimensions": { "w": 20, "h": 28 },
        "portrait_dimensions": { "w": 64, "h": 64 },
        "preview_prompt": "1-bit round friendly mascot sprite, smile visible"
      }
