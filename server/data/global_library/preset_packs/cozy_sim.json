    "hardware_menu_style": {
      "name": "Tools + Map + Settings",
      "spec": {
        "name": "Tools + Map + Settings",
        "menu_items": [
          { "slot": 1, "kind": "action", "title": "Tools", "action_or_options": "fn_open_tools" },
          { "slot": 2, "kind": "action", "title": "Map", "action_or_options": "fn_open_map" },
          { "slot": 3, "kind": "options", "title": "Speed", "action_or_options": ["1x", "2x", "4x"] }
        ],
        "pause_image_intent": "Player character relaxing in pixel hammock",
        "pause_image_prompt": "1-bit mascot in hammock between two trees, 400x240 left half",
        "lock_behavior": "save_and_pause",
        "auto_lock_disabled_scenes": []
