# Visual Pack Factory — OpenRouter provider config
# Copy to .env (not version-controlled) and fill in OPENROUTER_API_KEY.

# Required: OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
OPENROUTER_MODEL=openai/gpt-image-1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=120
OPENROUTER_RETRIES=2
