-- scenes/coin_vault_viewer.lua
-- 23 C0iNS Coin Vault display-only modal viewer.
-- Layout pixel-tight to docs/coingame.png reference.
-- D-pad navigates, A zooms to closeup, B returns to grid OR exits.

local gfx <const> = playdate.graphics
local Scene = {}

-- LAYOUT (per coingame.png reference)
local SCREEN_W, SCREEN_H = 400, 240
local TOP_BAR_Y, TOP_BAR_H = 0, 12

-- Grid: 4 cols x 6 rows of coins, left side
local GRID_X, GRID_Y = 8, 14
local CELL_W, CELL_H = 60, 26
local CELL_GAP_X, CELL_GAP_Y = 2, 1
local COLS, ROWS = 4, 6

-- Sidebar
local SIDE_X = 260
local SIDE_W = 138
local SIDE_INNER_X = SIDE_X + 4

-- Dialog bar
local DIALOG_Y, DIALOG_H = 178, 62
local PORTRAIT_X = 348
local PORTRAIT_W = 48

local coins_data = nil

local function load_coins()
    local f = playdate.file.open("data/coins.json", playdate.file.kFileRead)
    if not f then return nil end
    local raw = ""
    while true do
        local chunk = f:read(4096)
        if not chunk or chunk == "" then break end
        raw = raw .. chunk
    end
    f:close()
    return json and json.decode(raw) or nil
end

function Scene:init(args)
    args = args or {}
    self._return_label = args.return_label or 'pwnglove_playground'
end

function Scene:enter()
    if not coins_data then coins_data = load_coins() end
    self.cursor = 1   -- 1..24
    self.zoomed = false
    self._coin_by_id = {}
    if coins_data and coins_data.coins then
        for _, c in ipairs(coins_data.coins) do self._coin_by_id[c.id] = c end
    end
    self.locked_img = gfx.image.new("images/coins/coin_locked")
    self.coin_imgs = {}
    self.coin_imgs_large = {}
    for i = 0, 3 do
        self.coin_imgs[i] = gfx.image.new("images/coins/coin_" .. i)
        self.coin_imgs_large[i] = gfx.image.new("images/coins/coin_" .. i .. "_large")
    end
    self.dialog_lines = nil
    self.dialog_idx = 1
    self.dialog_advance_ms = 0
    self:update_dialog_for_cursor()
    if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("vault_door_open") end
end

function Scene:exit()
    if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("vault_door_close") end
    self.coin_imgs = nil
    self.coin_imgs_large = nil
end

function Scene:coin_at(cursor) return cursor - 1 end

function Scene:coin_status(id)
    if _G.progression and _G.progression.coin_status then
        return _G.progression.coin_status(id)
    end
    if id == 0 then return 'minted' end
    if id <= 2 then return 'available' end
    return 'locked'
end

function Scene:update_dialog_for_cursor()
    local id = self:coin_at(self.cursor)
    local c = self._coin_by_id[id]
    local lines = {}
    if c and c.dialog then
        if self.zoomed then
            if c.dialog.closeup then table.insert(lines, c.dialog.closeup) end
            if c.dialog.linger then table.insert(lines, c.dialog.linger) end
            if c.dialog.long_linger then table.insert(lines, c.dialog.long_linger) end
        else
            if c.dialog.grid_highlight then table.insert(lines, c.dialog.grid_highlight) end
        end
    else
        table.insert(lines, "Locked. Phrase not yet discovered.")
    end
    self.dialog_lines = lines
    self.dialog_idx = 1
    self.dialog_advance_ms = playdate.getCurrentTimeMilliseconds() + 3000
end

function Scene:update()
    if not self.dialog_lines then return end
    if #self.dialog_lines > 1 and playdate.getCurrentTimeMilliseconds() > self.dialog_advance_ms then
        self.dialog_idx = (self.dialog_idx % #self.dialog_lines) + 1
        self.dialog_advance_ms = playdate.getCurrentTimeMilliseconds() + 3000
    end
end

function Scene:input(evt)
    if evt == 'up' then
        if self.cursor - COLS >= 1 then
            self.cursor = self.cursor - COLS; self:update_dialog_for_cursor()
            if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("coin_navigate_tick") end
        end
    elseif evt == 'down' then
        if self.cursor + COLS <= 24 then
            self.cursor = self.cursor + COLS; self:update_dialog_for_cursor()
            if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("coin_navigate_tick") end
        end
    elseif evt == 'left' then
        if self.cursor > 1 then
            self.cursor = self.cursor - 1; self:update_dialog_for_cursor()
            if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("coin_navigate_tick") end
        end
    elseif evt == 'right' then
        if self.cursor < 24 then
            self.cursor = self.cursor + 1; self:update_dialog_for_cursor()
            if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("coin_navigate_tick") end
        end
    elseif evt == 'a' then
        if not self.zoomed then
            self.zoomed = true
            self:update_dialog_for_cursor()
            if audio_manager and audio_manager.play_sfx then audio_manager.play_sfx("coin_zoom_whoosh") end
        else
            if self.dialog_lines and #self.dialog_lines > 1 then
                self.dialog_idx = (self.dialog_idx % #self.dialog_lines) + 1
                self.dialog_advance_ms = playdate.getCurrentTimeMilliseconds() + 3000
            end
        end
    elseif evt == 'b' then
        if self.zoomed then
            self.zoomed = false
            self:update_dialog_for_cursor()
        else
            local prev = _G["Scene_" .. self._return_label] or _G[self._return_label]
            if prev and scene_manager and scene_manager.replace then
                scene_manager.replace(prev, {})
            end
        end
    end
end

----------------------------------------------------------------------------
-- DRAW
----------------------------------------------------------------------------

local function draw_coin_cell(self, i)
    local id = i - 1
    local col = (i - 1) % COLS
    local row = math.floor((i - 1) / COLS)
    local x = GRID_X + col * (CELL_W + CELL_GAP_X)
    local y = GRID_Y + row * (CELL_H + CELL_GAP_Y)

    -- cell frame (double-line, ref shows rounded-rect dual border)
    gfx.drawRoundRect(x, y, CELL_W, CELL_H, 2)

    -- coin id top-left
    gfx.drawText(tostring(id), x + 2, y + 1)

    -- coin face center (small)
    local img = (id < 4) and self.coin_imgs[id] or self.locked_img
    if id >= 4 then img = self.locked_img end
    if img then
        local iw, ih = img:getSize()
        -- scale 48x48 source down to ~18x18 for grid cell (PNG draw at center, slightly raised)
        img:drawScaled(x + (CELL_W - 18) / 2, y + 3, 18 / iw)
    end

    -- status text bottom of cell, center-aligned
    local status = self:coin_status(id)
    local label
    if status == 'minted' then label = 'MINTED'
    elseif status == 'available' then label = 'AVAILABLE'
    else label = 'LOCKED' end
    gfx.drawTextAligned(label, x + CELL_W / 2, y + CELL_H - 11, kTextAlignment.center)

    -- cursor highlight (per ref: clear double-line bracket around selected cell)
    if i == self.cursor then
        gfx.drawRoundRect(x - 2, y - 2, CELL_W + 4, CELL_H + 4, 3)
        gfx.drawRoundRect(x - 3, y - 3, CELL_W + 6, CELL_H + 6, 4)
    end
end

local function draw_top_bar()
    gfx.fillRect(0, 0, SCREEN_W, TOP_BAR_H)
    gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
    gfx.drawText("HAKCD > 23 C0iNS", 4, 0)
    -- right-side indicator arrow
    gfx.fillTriangle(SCREEN_W - 12, 2, SCREEN_W - 4, 6, SCREEN_W - 12, 10)
    gfx.setImageDrawMode(gfx.kDrawModeCopy)
end

local function draw_sidebar(self)
    -- vertical divider
    gfx.drawLine(SIDE_X - 1, 14, SIDE_X - 1, DIALOG_Y - 2)
    gfx.drawLine(SIDE_X, 14, SIDE_X, DIALOG_Y - 2)   -- double line

    -- "MINTED: N / 24" header
    local minted_n = (_G.progression and _G.progression.minted_count and _G.progression.minted_count()) or 1
    gfx.drawText(string.format("MINTED: %d / 24", minted_n), SIDE_INNER_X, 18)

    -- thin divider
    gfx.drawLine(SIDE_INNER_X, 32, SIDE_X + SIDE_W - 4, 32)

    -- "STATUS:"
    gfx.drawText("STATUS:", SIDE_INNER_X, 36)
    -- title in larger feel (still default font, but on own line, prominent)
    local id = self:coin_at(self.cursor)
    local c = self._coin_by_id[id]
    local title = (c and c.title) or (id >= 4 and "???" or "LOCKED")
    gfx.drawText(title, SIDE_INNER_X, 48)

    -- thin divider
    gfx.drawLine(SIDE_INNER_X, 64, SIDE_X + SIDE_W - 4, 64)

    -- large coin closeup at sidebar center
    local closeup = self.coin_imgs_large[id] or self.locked_img
    if closeup then
        local iw, ih = closeup:getSize()
        local target_w = 80
        local scale = target_w / iw
        local target_h = ih * scale
        local cx = SIDE_X + (SIDE_W - target_w) / 2
        local cy = 70
        -- starburst rays (4 short lines around coin)
        gfx.drawLine(cx - 6,         cy + target_h / 2,     cx - 2,         cy + target_h / 2)
        gfx.drawLine(cx + target_w + 2, cy + target_h / 2,  cx + target_w + 6, cy + target_h / 2)
        gfx.drawLine(cx + target_w / 2, cy - 6,             cx + target_w / 2, cy - 2)
        gfx.drawLine(cx + target_w / 2, cy + target_h + 2,  cx + target_w / 2, cy + target_h + 6)
        closeup:drawScaled(cx, cy, scale)
    end

    -- canonical rule text (wraps within sidebar width)
    gfx.drawTextInRect("Solving the entire coin earns you the next coin regardless of solve status.",
                       SIDE_INNER_X, 154, SIDE_W - 8, 20)

    -- footer: skull-and-crossbones "23 C0iNS"
    gfx.drawText("X 23 C0iNS X", SIDE_INNER_X + 14, DIALOG_Y - 14)
end

local function draw_dialog_bar(self)
    gfx.drawRect(0, DIALOG_Y, SCREEN_W, DIALOG_H)
    gfx.drawRect(1, DIALOG_Y + 1, SCREEN_W - 2, DIALOG_H - 2)
    -- newb name strip
    gfx.fillRect(2, DIALOG_Y + 2, 60, 12)
    gfx.setImageDrawMode(gfx.kDrawModeFillWhite)
    gfx.drawText("newb", 6, DIALOG_Y + 2)
    gfx.setImageDrawMode(gfx.kDrawModeCopy)
    -- divider under name
    gfx.drawLine(2, DIALOG_Y + 16, SCREEN_W - 2, DIALOG_Y + 16)
    -- dialog text (excludes portrait area)
    if self.dialog_lines and self.dialog_lines[self.dialog_idx] then
        gfx.drawTextInRect(self.dialog_lines[self.dialog_idx],
                           6, DIALOG_Y + 20, PORTRAIT_X - 12, DIALOG_H - 22)
    end
    -- portrait box right
    gfx.drawRect(PORTRAIT_X, DIALOG_Y + 2, PORTRAIT_W, DIALOG_H - 4)
    local portrait = gfx.image.new("images/portraits/newb")
    if portrait then
        local pw, ph = portrait:getSize()
        portrait:draw(PORTRAIT_X + (PORTRAIT_W - pw) / 2, DIALOG_Y + 4)
    else
        gfx.drawTextAligned("newb", PORTRAIT_X + PORTRAIT_W / 2, DIALOG_Y + 30, kTextAlignment.center)
    end
end

function Scene:draw()
    gfx.clear(gfx.kColorWhite)

    draw_top_bar()

    if not self.zoomed then
        for i = 1, 24 do draw_coin_cell(self, i) end
    else
        -- zoomed view: large coin centered in main area (left of sidebar)
        local id = self:coin_at(self.cursor)
        local closeup = self.coin_imgs_large[id] or self.locked_img
        if closeup then
            local iw, ih = closeup:getSize()
            local target = math.min(150, SIDE_X - 30)
            local scale = target / iw
            closeup:drawScaled((SIDE_X - target) / 2, 20 + (140 - target) / 2, scale)
        end
        -- starburst rays in zoom too (4 long)
        local cx, cy = (SIDE_X) / 2, 90
        gfx.drawLine(cx - 100, cy, cx - 85, cy)
        gfx.drawLine(cx + 85, cy, cx + 100, cy)
        gfx.drawLine(cx, cy - 75, cx, cy - 60)
        gfx.drawLine(cx, cy + 60, cx, cy + 75)
    end

    draw_sidebar(self)
    draw_dialog_bar(self)
end

_G["coin_vault_viewer"] = Scene
_G["Scene_coin_vault_viewer"] = Scene
return Scene
